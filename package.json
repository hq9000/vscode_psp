{
  "name": "vscode-psp",
  "displayName": "VSCode PSP - Python Sonic Pi",
  "description": "Live coding with Python and Sonic Pi in VSCode",
  "version": "0.1.0",
  "publisher": "hq9000",
  "icon": "icon.svg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onCommand:vscode-psp.start",
    "onCommand:vscode-psp.stopServer",
    "onCommand:vscode-psp.restartServer",
    "onCommand:vscode-psp.checkServerStatus",
    "onCommand:vscode-psp.run"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-psp.start",
        "title": "PSP: Start Sonic Pi Server"
      },
      {
        "command": "vscode-psp.stopServer",
        "title": "PSP: Stop Sonic Pi Server"
      },
      {
        "command": "vscode-psp.restartServer",
        "title": "PSP: Restart Sonic Pi Server"
      },
      {
        "command": "vscode-psp.checkServerStatus",
        "title": "PSP: Check Server Status"
      },
      {
        "command": "vscode-psp.run",
        "title": "PSP: Run Current File"
      }
    ],
    "languages": [
      {
        "id": "python",
        "extensions": [
          ".live.py"
        ],
        "aliases": [
          "Python (Live)"
        ]
      }
    ],
    "configuration": {
      "title": "VSCode PSP",
      "properties": {
        "vscode-psp.sonicPiRootDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to Sonic Pi installation directory. Leave empty for auto-detection. Platform-specific defaults:\n- **Windows**: `C:\\Program Files\\Sonic Pi`\n- **macOS**: `/Applications/Sonic Pi.app`\n- **Linux**: `/opt/sonic-pi` or `/usr/lib/sonic-pi`"
        },
        "vscode-psp.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Sonic Pi server when opening a .live.py file"
        },
        "vscode-psp.outputFile": {
          "type": "string",
          "default": "${workspaceFolder}/last.rb",
          "description": "Path to the output Ruby file that will be sent to Sonic Pi"
        },
        "vscode-psp.serverPort": {
          "type": "number",
          "default": 4557,
          "description": "Port number for Sonic Pi server communication (default: 4557)"
        },
        "vscode-psp.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter. Leave empty to auto-detect from VSCode Python extension or system PATH."
        },
        "vscode-psp.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Logging level for extension output"
        },
        "vscode-psp.logAutoscroll": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scroll to the bottom of the log output"
        },
        "vscode-psp.logClearOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Clear the log output when running a file"
        },
        "vscode-psp.flashBackgroundColor": {
          "type": "string",
          "default": "rgba(255,20,147,1.0)",
          "description": "Background color for flash feedback (CSS color format)"
        },
        "vscode-psp.flashTextColor": {
          "type": "string",
          "default": "rgba(255,255,255,1.0)",
          "description": "Text color for flash feedback (CSS color format)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p tsconfig.test.json --outDir out/test",
    "watch-tests": "tsc -p tsconfig.test.json -w --outDir out/test",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "osc-js": "^2.4.0",
    "tree-kill": "^1.2.2"
  }
}
